    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Mostrar solo la primera señal (primera fila)\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.plot(dataframe.iloc[2, :])  # Toma los primeros 140 datos de la primera fila\n",
        "plt.title(\"ECG 0\")\n",
        "plt.xlabel(\"Tiempo\")\n",
        "plt.ylabel(\"Amplitud\")\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ],
