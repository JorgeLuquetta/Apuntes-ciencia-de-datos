      "source": [
        "import pandas as pd # Importamos la biblipoteca pandas\n",
        "# Bajamos el dataset\n",
        "dataframe = pd.read_csv('http://storage.googleapis.com/download.tensorflow.org/data/ecg.csv', header=None)\n",
